# Template pour le build cabinet. Copier vers `.env.production` avant `npm run build`.
# `.env.production` est matché par `*.local`? NON. Copier manuellement et garder hors git.

# IP ou hostname du PC serveur du cabinet. Exemple : http://192.168.1.10:3000
# En Phase 2 : https://cabinet-cenon.local:8443
VITE_SERVER_URL=http://192.168.1.10:3000

# Token partagé (doit matcher la valeur du fichier .env côté serveur cabinet).
# Générer avec : openssl rand -hex 32
VITE_OFFICE_TOKEN=REMPLACER_PAR_LA_VALEUR_DU_SERVEUR
