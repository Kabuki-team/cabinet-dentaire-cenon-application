# Copier vers .env et ajuster les valeurs avant le premier démarrage

# Port d'écoute HTTP (LAN uniquement en Phase 1, passer en HTTPS:8443 en Phase 2)
PORT=3000

# Interface d'écoute. 0.0.0.0 pour exposer sur le LAN. 127.0.0.1 pour dev local uniquement.
HOST=0.0.0.0

# Token d'authentification partagé par tous les postes (Phase 1). Remplacer par JWT + comptes utilisateurs en Phase 2.
# Générer une valeur robuste : `openssl rand -hex 32`
OFFICE_TOKEN=changeme-generate-with-openssl-rand-hex-32

# Chemin du fichier SQLite (créé automatiquement s'il n'existe pas).
# En production Windows : C:\Cabinet\data\cenon.db
DB_PATH=./data/cenon.db

# Répertoire du build React servi en statique (optionnel en Phase 1).
# Les cabinets peuvent soit pointer leur Tauri ici, soit ouvrir l'URL dans Chrome/Edge.
# Laisser vide pour désactiver le service statique.
STATIC_DIR=../dist

# Niveau de log Fastify : fatal | error | warn | info | debug | trace
LOG_LEVEL=info
